<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loopback test of the desktop optical path (QrStream -> ScaledQr -> CameraReceiver -> received files).
       Builds the Linux host with the MiniUI DLLs bundled in runtime/linux-x64. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>enable</Nullable>
    <StartupObject>FileXfer.Probe.NativeLoopbackProbe</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../desktop/FileXfer.MiniUI.csproj" />
    <Reference Include="zxing"><HintPath>../lib/zxing.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="NativeLoopbackProbe.cs" />
  </ItemGroup>
</Project>
